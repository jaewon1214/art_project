# ============================================================================
# 서버(AWS EC2)용 .env — database/ 폴더만 서버에 올리고, 여기 이 파일을 .env로 복사해서 채움.
# docker-compose.yml(Postgres+Neo4j 컨테이너 부팅)만 이 파일을 읽음 — 로컬 파이썬 파이프라인은
# 안 씀(로컬은 repo 루트의 .env.example 기준 별도 .env를 씀). 절대 GitHub에 올리지 말 것.
# ============================================================================

DB_USER=app
DB_PASSWORD=app_password
DB_NAME=music_ai_papers
DB_PORT=5432

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

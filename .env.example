# ============================================================================
# 로컬 PC용 .env — 이 파일을 .env로 복사해서 채우고, .env는 절대 GitHub에 올리지 않는다.
# (파이썬 파이프라인 — collector/, rag/(entity_extraction·pipeline·retrieval 등) — 이 파일을 읽음)
#
# 서버(AWS EC2)에 올리는 .env는 이 파일이 아니라 .env.server.example 기준으로 따로 만듦 —
# 둘은 용도가 다른 별개 파일이니 섞지 말 것. 자세한 설명은 README.md "두 개의 .env" 참고.
# ============================================================================

# DB_HOST=localhost 면 내 PC의 docker-compose DB, 서버 DB를 쓰려면 아래 "서버 DB 접속" 참고
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app_password
DB_NAME=music_ai_papers

# embedding — OpenAI text-embedding-3-large(dimensions=1536으로 truncate해서 씀) 확정.
# 다국어(한국어+영어) 검색 성능 때문에 -small 대신 -large로 확정함. database/init/01_schema.sql의
# VECTOR(1536)과 이미 일치하니 그대로 쓰면 됨. LLM_API_KEY랑 같은 OpenAI 키 써도 됨.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=

# Neo4j (내 PC의 docker-compose neo4j 서비스에 맞춘 기본값)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# LLM 엔티티 추출 (rag/entity_extraction/) — 문서 → 아티스트/회사/AI모델/이슈 자동 추출 → Neo4j 동기화.
# 비워두면 rag/pipeline/ingest.py가 이 단계를 자동으로 건너뜀 (Postgres 저장까지는 그대로 진행).
# 이 키는 로컬 파이프라인에서만 쓰니까 서버 .env에는 필요 없음.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# case_collector.py — open.law.go.kr에서 API 사용 승인받은 뒤 발급되는 OC 값(보통 신청 시
# 등록한 이메일의 @ 앞부분). 비워두면 case_collector.collect()가 빈 리스트를 반환하고
# 조용히 건너뜀 — 승인 나면 채워 넣기만 하면 다음 수집부터 자동으로 판례가 들어옴.
LAW_API_OC=

# news_collector.py — NewsAPI.org 검색 API 키(newsapi.org 무료 가입 후 발급). 비워두면
# NewsAPI 검색은 건너뛰고 기존 RSS 피드만 동작함. 무료 플랜은 하루 100 요청 제한 +
# "개발/테스트용" 명시(상용 서비스 금지) — 학교 프로젝트/리서치 용도로만 사용할 것.
NEWSAPI_KEY=

# ----------------------------------------------------------------------------
# 서버 DB 접속 — 로컬 코드로 내 PC 대신 AWS 서버(43.203.178.125, IP 바뀌면 최신값으로 갱신)의
# DB에 붙고 싶을 때만 아래 두 줄을 위 DB_HOST/NEO4J_URI 대신 주석 풀어서 쓸 것.
# DB_USER/DB_PASSWORD/DB_NAME/NEO4J_USER/NEO4J_PASSWORD는 서버 .env.server에 설정한 값과
# 반드시 똑같이 맞춰야 함 (같은 DB에 접속하는 거라 계정이 같아야 함).
#
# DB_HOST=43.203.178.125
# NEO4J_URI=bolt://43.203.178.125:7687
# ----------------------------------------------------------------------------